expanded{opacity:1;pointer-events:auto;}\n\n/* Título expandido — 45px */\n.fa-panel-title{font-family:'Helvetica Now Display','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:45px;line-height:1.1;margin-bottom:16px;letter-spacing:0.01em;}\n.fa-panel-title .light{font-weight:300;}\n.fa-panel-title .bold{font-weight:500;}\n\n.fa-panel-divider{width:32px;height:1px;background:rgba(255,255,255,0.5);margin-bottom:16px;}\n\n/* Subtítulo — 18px */\n.fa-panel-subtitle{font-family:'Helvetica Now Text','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:18px;font-weight:500;line-height:1.6;opacity:0.85;margin-bottom:28px;max-width:400px;}\n\n.fa-panel-btn{display:inline-block;padding:10px 24px;border:1px solid rgba(255,255,255,0.7);color:#fff;font-size:12px;font-weight:400;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;transition:background 0.3s ease;width:fit-content;}\n.fa-panel-btn:hover{background:rgba(255,255,255,0.15);}\n\n@media(max-width:768px){\n  .fa-hero-accordion{flex-direction:column;height:auto!important;}\n  .fa-panel{flex:none!important;height:120px!important;min-width:unset;border-right:none;border-bottom:1px solid rgba(255,255,255,0.15);transition:height 0.6s cubic-bezier(0.77,0,0.175,1);}\n  .fa-panel:last-child{border-bottom:none;}\n  .fa-hero-accordion:hover .fa-panel{height:120px!important;min-width:unset;}\n  .fa-hero-accordion .fa-panel:hover{height:380px!important;}\n  .fa-panel-sigla{bottom:24px;left:28px;font-size:40px;}\n  .fa-panel-expanded{bottom:24px;left:28px;right:28px;}\n  .fa-panel-subtitle{font-size:16px;}\n  .fa-hero-accordion:hover .fa-panel:hover .fa-panel-expanded{opacity:1;}\n}\n</style>\n\n<div class=\"fa-hero-accordion\">\n\n  <div class=\"fa-panel\">\n    <div class=\"fa-panel-bg\" style=\"background-image:url('https://papayawhip-fly-823460.hostingersite.com/wp-content/uploads/2026/05/FA-WEB-ALVEAR.jpg');\"></div>\n    <div class=\"fa-panel-overlay\"></div>\n    <div class=\"fa-panel-content\">\n      <div class=\"fa-panel-sigla\">FAP</div>\n      <div class=\"fa-panel-expanded\">\n        <div class=\"fa-panel-title\"><span class=\"light\">Fabián Achával</span> <span class=\"bold\">Propiedades</span></div>\n        <div class=\"fa-panel-divider\"></div>\n        <div class=\"fa-panel-subtitle\">Una inmobiliaria tradicional + un departamento de inteligencia + una think tank de información + un departamento de innovación.</div>\n        <a href=\"/propiedades\" class=\"fa-panel-btn\">Ver propiedades</a>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"fa-panel\">\n    <div class=\"fa-panel-bg\" style=\"background-image:url('https://papayawhip-fly-823460.hostingersite.com/wp-content/uploads/2026/05/FA-WEB-DI-MACHINE-LEARNIG.jpg');\"></div>\n    <div class=\"fa-panel-overlay\"></div>\n    <div class=\"fa-panel-content\">\n      <div class=\"fa-panel-sigla\">DI</div>\n      <div class=\"fa-panel-expanded\">\n        <div class=\"fa-panel-title\"><span class=\"light\">Departamento de Investigación &amp;</span> <span class=\"bold\">Consultoría</span></div>\n        <div class=\"fa-panel-divider\"></div>\n        <div class=\"fa-panel-subtitle\">Conocimiento aplicado para interpretar mercados y diseñar decisiones en múltiples contextos.</div>\n        <a href=\"/investigacion\" class=\"fa-panel-btn\">Explorar</a>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"fa-panel\">\n    <div class=\"fa-panel-bg\" style=\"background-image:url('https://papayawhip-fly-823460.hostingersite.com/wp-content/uploads/2026/05/FA-RADAR-COVER-scaled.jpg');\"></div>\n    <div class=\"fa-panel-overlay\"></div>\n    <div class=\"fa-panel-content\">\n      <div class=\"fa-panel-sigla\">\n        <img src=\"https://papayawhip-fly-823460.hostingersite.com/wp-content/uploads/2026/05/RADAR-ISO-1.svg\" alt=\"Radar\" />\n      </div>\n      <div class=\"fa-panel-expanded\">\n        <div class=\"fa-panel-title\"><span class=\"bold\">Radar</span></div>\n        <div class=\"fa-panel-divider\"></div>\n        <div class=\"fa-panel-subtitle\">El informe más importante del sector inmobiliario.</div>\n        <a href=\"/radar\" class=\"fa-panel-btn\">Ver Radar</a>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"fa-panel\">\n    <div class=\"fa-panel-bg\" style=\"background-image:url('https://papayawhip-fly-823460.hostingersite.com/wp-content/uploads/2026/05/FAPi-Stills-011.jpg');\"></div>\n    <div class=\"fa-panel-overlay\"></div>\n    <div class=\"fa-panel-content\">\n      <div class=\"fa-panel-sigla\">FAi</div>\n      <div class=\"fa-panel-expanded\">\n        <div class=\"fa-panel-title\"><span class=\"light\">FA</span> <span class=\"bold\">Intelligence</span></div>\n        <div class=\"fa-panel-divider\"></div>\n        <div class=\"fa-panel-subtitle\">Herramientas y tecnología para operar a la velocidad de la realidad.</div>\n        <a href=\"/fai\" class=\"fa-panel-btn\">Conocer FAi</a>\n      </div>\n    </div>\n  </div>\n\n</div>","custom_css":"selector {\n  padding: 0 !important;\n  margin: 0 !important;\n  width: 100% !important;\n}"},"elements":[],"widgetType":"html"}],"isInner":false}]
